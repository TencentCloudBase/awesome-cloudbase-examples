# ========================================
# pay-stripe 环境变量配置
# 复制此文件为 .env 并填入实际值
#
# ⚠️ 代码只读 process.env，**没有 dotenv**：`.env` 不会被自动加载。
#    本地请用 `export $(cat .env | xargs)`，或 docker 用 `--env-file .env`。
# ========================================

# ---------- 回调类型声明（由集成中心自动注入，一般不用手填）----------
# ⚠️ stripe-pay 集成实测**不做网关代验签**：无签名请求也会被网关直接转发到函数，
#    且转发的是 Stripe 原始报文（没有 ParsedContent / ParsedNotify 明文）。
#    因此本模板的回调**一律由云函数自验签**，没有 notifyURLCallbackType 这类开关。
#
# 🚨 stripeWebhookSecret 必填（whsec_ 开头）：缺了它所有回调都会 400。

# ---------- Stripe 凭证 ----------
# 服务端密钥（必填）。测试模式用 sk_test_、正式用 sk_live_
# 建议改用受限密钥 rk_（只勾选所需写权限），比全权限 sk_ 更安全
# ⚠️ 不要提交到 git，不要硬编码在代码里
stripeSecretKey=

# Webhook 验签密钥（whsec_）。必填 —— 回调由本函数自验签
# ⚠️ 只在创建 endpoint 时返回一次，丢失只能删掉重建；test / live 各一套
stripeWebhookSecret=

# 锁定 API 版本（如 2026-08-26.dahlia）
# ⚠️ Stripe 版本升级刻意不向后兼容，不锁版本会因字段路径变化而静默失效
stripeApiVersion=

# ---------- Checkout 跳转地址 ----------
# ui_mode=hosted_page 时必填；前端请求体里传了就以请求体为准
# 必须是 https://，且不能是 localhost（Stripe 支付完成后要跳回公网地址）
# ⚠️ 需要回跳后查单时，success_url 必须带 Stripe 占位符 {CHECKOUT_SESSION_ID}（原样、不要编码），
#    否则回跳 URL 上没有 session_id。例：https://example.com/pay?session_id={CHECKOUT_SESSION_ID}
stripeSuccessUrl=
stripeCancelUrl=

# 回跳域名白名单（多个逗号分隔，只写域名）。**可选**：不配 = 只校验 http/https，
# 回跳地址以调用方传入为准（本模板定位是开放给接入方自行使用）。
# 需要收敛开放重定向面时再配：配了就强制命中白名单
stripeAllowedReturnDomains=

# 期望的 JWT 签发方（可选）。配了会校验 payload.iss 精确匹配；
# 注意：JWT payload 只用于回填邮箱，不参与鉴权（身份来自网关注入的 x-userid）
AUTH_EXPECTED_ISSUER=

# ---------- 跨域 ----------
# 前端页面与云函数不同源时必填，多个用逗号分隔（app.js 读取）
# 缺失时浏览器会拦掉 CORS 响应头，表现为「请求失败但没有服务端日志」
corsAllowOrigin=

# ---------- 本地调试（不部署到云端）----------
# bin/www 本地监听端口（云托管/云函数运行时会注入 PORT，本地不设默认 3000）
PORT=3000

# 本地联调放行未登录调用（默认关闭，**生产严禁开启**）
# 只有显式写 true 才生效；放行时每次都会打 warn 日志，不会静默放过
# 业务接口的正规身份来源：经网关鉴权入口调用（HTTP API 带 AccessToken，
# 或开启身份认证的自定义域名路由），函数只认网关注入的 x-userid + x-authmethod
ALLOW_ANONYMOUS_DEV=
