# ========================================
# pay-common 环境变量配置
# 复制此文件为 .env 并填入实际值
# key 与授权类型 Ext 字段对齐
# ========================================

# ---------- 签名模式切换 ----------
# gateway: 回调由集成中心解密，转发明文（默认，正式上线模式）
# sdk: 回调自己验签 + AES-GCM 解密
# 注意：两种模式下，主动请求（下单/退款/转账）都走 SDK 自签名直连微信
signMode=gateway

# ---------- 回调类型声明（由集成中心自动注入，一般不用手填）----------
# system      → 回调地址托管在集成中心，网关代验签 + 代解密，转发明文 body.ParsedContent
# ownservice  → 回调指向本函数，验签解密由本函数完成
# 空（默认）  → 未声明，按「自己验签」处理（fail closed）
#
# 免验签需要 signMode=gateway 且本变量为 system 同时成立；否则即使请求体里塞了
# {"ParsedContent":{"out_trade_no":"X","trade_state":"SUCCESS"}} 也不会生效，
# 会退回自验签并因缺少签名头被拒。
#
# ⚠️ 走集成中心创建实例时由平台注入，不要手工覆盖；本地自测网关回调可以临时设 system。
notifyURLCallbackType=

# ---------- 微信支付基础配置 ----------
# 小程序/公众号 AppID（注意不同支付方式对应不同类型的 AppID）
# 小程序下单 → 小程序 AppID | H5 下单 → 公众号 AppID
appId=
# 服务号 AppID（同一个商户号绑定的服务号，用于 Web 端 JSAPI 支付）
# 调用时传 useServiceAccount: true 即可使用该 AppID
service_app_id=
# 支付商户号
merchantId=
# 商户 API 证书序列号
merchantSerialNumber=
# API V3 密钥（32 字节，用于回调解密）
apiV3Key=

# ---------- 凭证配置（两种模式都需要）----------
# 商户 API 证书私钥（PEM 格式字符串，用于请求签名）
# 注意：不要提交到 git，不要硬编码在代码中
privateKey=
# 微信支付公钥（PEM 格式字符串，用于验签）
wxPayPublicKey=
# 微信支付公钥 ID（标识使用哪个公钥）
wxPayPublicKeyId=

# ---------- 回调通知 URL ----------
# 必须以 https:// 开头，不能用 localhost/127.0.0.1，不能带参数
# SDK 模式：填云函数/云托管自己的公网 URL
# 网关模式：填集成中心分配的回调域名
notifyURLPayURL=
notifyURLRefundsURL=
# 商家转账回调（可选，不设则转账不接收回调通知。Ext 字段无此项，pay-common 扩展）
transferNotifyUrl=

# ---------- 服务端口（本地开发/云托管用）----------
PORT=3000

# ---------- CORS 跨域 / H5 鉴权 ----------
# 仅当前端页面与本服务不同源时配置（如 H5 页面直接调用）
# 多个域名逗号分隔，例：https://a.com,https://b.com
# ⚠️ H5 路由（/wxpay_order_h5）强制要求：不填则所有 H5 下单请求返回 403
#    校验顺序：Origin 缺失时回退 Referer，两者都没有直接 403
corsAllowOrigin=

# H5 下单是否允许匿名（无登录态）调用，默认关闭
# ⚠️ 仅本地跑 examples/react 测试页时设 true；生产必须保持关闭，
#    生产环境应由前端带 Authorization: Bearer <CloudBase Auth token>
ALLOW_ANONYMOUS_H5=

# JWT 签发方校验（可选）：配了就强校验 payload.iss，不匹配直接 401
AUTH_EXPECTED_ISSUER=

# ---------- 联调开关（全模板只有这一个变量）----------
# 取值只有两个，决定 orderService 的 4 个钩子是否启用：
#
#   PAY_GUARD=on  → 生产模式（默认，不设也是 on）：4 个钩子全部生效，按 fail closed 拒绝
#   PAY_GUARD=off → 联调模式：跳过 4 个钩子，金额与订单归属全由客户端决定
#   不设          → 等同 on（漏配也不会放开）
#
# on / 不设 时的表现：
#   下单                 → 400「服务端未核定订单金额」（verifyAmount）
#   退款                 → 400「服务端未核定可退金额」（verifyRefundAmount）
#   查单/关单/退款/查退款 → 403「未校验订单归属」（verifyOrderOwner）
#   转账/查转账单         → 403「未校验转账权限」（verifyTransferAllowed）
#
# 本地联调用 `npm run dev`（已自动设 PAY_GUARD=off）；部署配置（cloudbaserc / Dockerfile）写 PAY_GUARD=on。
# ⚠️ off 下 = 任何人可改金额下单、操作别人的订单、把商户余额转给任意 openid。详见 README
PAY_GUARD=
