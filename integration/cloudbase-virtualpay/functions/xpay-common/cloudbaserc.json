{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "{{env.TCB_ENV_ID}}",
  "functions": [
    {
      "name": "xpay-common",
      "dir": "./",
      "type": "HTTP",
      "timeout": 30,
      "runtime": "Nodejs24.11",
      "handler": "index.main",
      "memorySize": 256,
      "installDependency": true,
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        "tests",
        "*.pem"
      ],
      "envVariables": {
        "appId": "{{env.appId}}",
        "secret": "{{env.secret}}",
        "offerId": "{{env.offerId}}",
        "appKey": "{{env.appKey}}",
        "notifyURLCallbackType": "{{env.notifyURLCallbackType}}",
        "msgEncryptType": "{{env.msgEncryptType}}",
        "token": "{{env.token}}",
        "msgSecret": "{{env.msgSecret}}",
        "XPAY_GUARD": "on"
      }
    }
  ],
  "integrations": [
    {
      "keyId": "wxvirtualpay",
      "name": "小程序虚拟支付",
      "authTypeCode": "wxvirtualpay",
      "description": "小程序虚拟支付（道具直购 / 代币支付）",
      "demoCodeFunctionName": "xpay-common",
      "envVariables": {
        "appId": "{{env.appId}}",
        "secret": "{{env.secret}}",
        "offerId": "{{env.offerId}}",
        "appKey": "{{env.appKey}}",
        "notifyURLCallbackType": "{{env.notifyURLCallbackType}}",
        "msgEncryptType": "{{env.msgEncryptType}}",
        "token": "{{env.token}}",
        "msgSecret": "{{env.msgSecret}}"
      }
    }
  ]
}