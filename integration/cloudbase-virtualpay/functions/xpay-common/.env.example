# ========================================
# xpay-common 环境变量配置
#
# 用法：
#   本地开发  cp .env.example .env 并填入实际值（.env 已被 gitignore）
#   线上部署  集成中心自动注入，不需要上传 .env
#
# 🚨 secret 是小程序最高权限凭证，禁止提交到仓库、禁止写进客户端
#
# 变量只有两类：
#   平台注入  appId / secret / offerId / appKey / token / msgSecret
#             / notifyUrlCallbackType / msgEncryptType / sandboxAppKey
#             → 集成中心创建实例时注入，并**覆盖**云函数上的同名变量
#             → 与 cloudbaserc.json 的 {{env.X}} 是同一份信息，本地自测可一并填全
#             → 只有「直连 HTTP 访问服务自测」时才必须本地填
#   本模板    notifyFormat / trustBearerIdentity
#             → 平台不注入，只能由 cloudbaserc.json 的函数级 envVariables 提供
# ========================================

# ---------- 部署目标 ----------
# ⚠️ 必填：cloudbaserc.json 的 envId 是 {{env.TCB_ENV_ID}}，空值会导致部署失败
# 出处：云开发控制台 → 环境 → 环境ID
TCB_ENV_ID=

# ========================================
# 平台注入的凭证（本地自测才填，部署形态留空即可）
# ========================================

# ---------- 虚拟支付凭证 ----------
# 出处：MP 后台 → 虚拟支付 → 基本配置
# 虚拟支付商户号（米大师分配的应用 ID）
offerId=
# 支付签名密钥（用于计算 paySig），只放服务端
appKey=
# 沙箱 AppKey：本模板只走现网（env 固定 0），代码不读取，留空。
# 保留这个键只是为了说明集成中心会注入它。
sandboxAppKey=

# ---------- 小程序凭证 ----------
# 出处：MP 后台 → 设置 → 基本设置
appId=
# 用于 code2Session 换取 sessionKey（计算 signature 必需）
# ⚠️ 云函数上下文的 getWXContext() 不提供 sessionKey，必须由服务端自行换取
secret=

# ---------- 消息推送（回调验签 / 解密）----------
# 出处：MP 后台 → 开发管理 → 消息推送
# ⚠️ 谁在用这两个值取决于回调形态：
#    notifyUrlCallbackType=ownservice → 本函数自己验签解密，必须填
#    notifyUrlCallbackType=system     → 网关代验签解密，本函数不读，可留空
# ⚠️ 键名是 token，不是 msgToken
token=
msgSecret=

# ---------- 回调形态 ----------
# system=系统内置回调地址（网关代验签） / ownservice=用户自定义回调地址（本函数验签）
# ⚠️ 拼写是 ownservice，不是 ownService / pwnservice
# 托管形态由平台按集成配置注入，本地自测才需填
notifyUrlCallbackType=
# plaintext=明文 / aes=安全模式 / compatible=兼容（明文与密文同时下发，解密失败可回退明文）
# ⚠️ 必须与 MP 后台「消息加密方式」一致，否则实际收到的形态与声明不符
msgEncryptType=

# 注：notifyUrlResourceType / notifyUrlResourceName 是平台系统字段，
#     由 tcb integration create 依据 demoCodeFunctionName 自动写入集成 Ext；
#     不要写进 cloudbaserc.json 或这里，代码按空串兜底处理。

# ========================================
# 本模板自己的配置（平台不注入，必须配）
# ========================================

# ---------- 回调数据格式 ----------
# json（默认）/ xml
# ⚠️ 必须与微信后台「消息推送」登记的数据格式一致，否则微信会重推最多 15 次
notifyFormat=json

# ---------- 服务端 / 第三方调用身份（默认关闭，可不填）----------
# 是否采信 Authorization: Bearer <access_token> 里的身份（取 JWT 的 provider_sub）
# 默认空 = 不采信：JWT payload 只是 base64 编码，任何人都能伪造。
# 仅当该环境的云函数【只经云 API 网关暴露】（网关已验证 token 签名）时才设 true。
# ⚠️ 若函数同时能被公网直连，开启此开关等于允许伪造 Bearer 冒充任意用户。
trustBearerIdentity=

# ---------- 联调闸门（全模板只有这一个变量）----------
# 取值只有两个，决定「订单归属 / iOS 退款问询」的校验是否生效：
#
#   XPAY_GUARD=on  → 生产态（默认，不设也是 on）：本地查不到订单 → 拒绝查单、拦截退款
#   XPAY_GUARD=off → 联调模式：本地查不到订单 → 放行查单、result_code=0 放过退款
#   不设          → 等同 on（漏配也不会放开）
#
# ⚠️ 本示例用进程内 Map 存订单，冷启动后必然查不到；off 就是为这个场景准备的。
#    生产必须落库并按 openid 查询，那时这个开关保持 on 即可。
# 本地联调用 `npm run dev`（已自动设 off）；云上 + off 会拒绝启动，确需云上联调
# 还要额外设 PAY_ALLOW_INSECURE_BOOT=true。
XPAY_GUARD=

# ---------- 服务端口（仅本地开发用）----------
# 云函数 SCF 环境固定 9000（见 scf_bootstrap），云托管为 80
PORT=3000
