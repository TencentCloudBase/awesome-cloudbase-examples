# ========================================
# xpay-common 环境变量配置
#
# 用法：
#   本地开发  cp .env.example .env 并填入实际值（.env 已被 gitignore）
#   线上部署  值由集成中心 / 云函数环境变量注入，不需要上传 .env
#
# 🚨 secret 是小程序最高权限凭证，禁止提交到仓库、禁止写进客户端
#
# 变量名与集成中心注入保持一致：offerId / appKey / appId / secret
# （旧名 prodAppKey / appSecret 仍兼容，代码会回退读取）
#
# 🚨 键名必须与 cloudbaserc.json 里 {{env.xxx}} 的 xxx 逐字一致，
#    否则 CLI 部署时解析不到 → 写成空值 → 云函数环境变量被覆盖成空。
#    校验：bash ../../skill/cloudbase-xpay/scripts/check_env_keys.sh
# ========================================

# ---------- 部署目标 ----------
# ⚠️ 必填：cloudbaserc.json 的 envId 是 {{env.TCB_ENV_ID}}，空值会导致部署失败
# 出处：云开发控制台 → 环境 → 环境ID
TCB_ENV_ID=

# ---------- 虚拟支付凭证 ----------
# 出处：MP 后台 → 虚拟支付 → 基本配置
# 虚拟支付商户号（米大师分配的应用 ID）
offerId=
# 支付签名密钥（用于计算 paySig），只放服务端
appKey=
# 沙箱 AppKey：本模板只走现网（env 固定 0），留空即可。
# 保留这个键是为了与集成中心注入的环境变量清单逐字对齐。
sandboxAppKey=

# ---------- 小程序凭证 ----------
# 出处：MP 后台 → 设置 → 基本设置
appId=
# 用于 code2Session 换取 sessionKey（计算 signature 必需）
# ⚠️ 云函数上下文的 getWXContext() 不提供 sessionKey，必须由服务端自行换取
secret=

# ---------- 消息推送（回调验签 / 解密）----------
# 出处：MP 后台 → 开发管理 → 消息推送
# ⚠️ 调用方式决定谁在用这两个值：
#    notifyUrlCallbackType=ownservice → 本函数自己验签解密，必须填
#    notifyUrlCallbackType=system     → 网关代验签解密，本函数不读，可留空
# ⚠️ 键名是 token（与 cloudbaserc.json 的 {{env.token}} 一致），不是 msgToken
token=
msgSecret=

# ---------- 回调形态（决定「谁负责验签解密」，不填则退回按 token 是否配置判断）----------
# system=系统内置回调地址（网关代验签） / ownservice=用户自定义回调地址（本函数验签）
# ⚠️ 拼写是 ownservice，不是 ownService / pwnservice
notifyUrlCallbackType=
# function=回调打到云函数 / cloudrun=回调打到云托管
notifyUrlResourceType=
# plaintext=明文 / aes=安全模式 / compatible=兼容（明文与密文同时下发，解密失败可回退明文）
# ⚠️ 必须与 MP 后台「消息加密方式」一致，否则实际收到的形态与声明不符
msgEncryptType=

# ---------- 回调配置 ----------
# json（默认）/ xml
# ⚠️ 必须与微信后台「消息推送」登记的数据格式一致，否则微信会重推最多 15 次
notifyFormat=json

# ---------- 模板自定义开关（⚠️ 平台不注入，仅本模板读取）----------
# 以下 4 个已声明进 cloudbaserc.json 的函数级 envVariables，改这里再部署即可生效；
# 若不在那里声明，云函数上就没有这个变量，设了也等于没设。
#
# 是否要求调用方身份。默认空（宽松）——信任上游网关已完成鉴权。
# 若云函数会被直接暴露到公网，设为 true，只放行平台注入的 x-wx-openid
requireCallerAuth=
# 是否采信未验签的 Bearer JWT payload。默认空（不采信）——payload 可伪造。
# 仅当确认「请求必经上游网关验签」时才设为 true
trustUnverifiedJwt=

# ---------- CORS 跨域（可选）----------
# 仅当前端页面与本服务不同源时配置
# 多个域名逗号分隔，例：https://a.com,https://b.com
# 不填则不开放跨域
corsAllowOrigin=

# ---------- 服务端口（仅本地开发用）----------
# 云函数 SCF 环境固定 9000（见 scf_bootstrap），云托管为 80
PORT=3000
