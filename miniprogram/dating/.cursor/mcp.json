{
    "mcpServers": {
        "cloudbase-remote": {
            "type": "http",
            "url": "https://tcb-api.cloud.tencent.com/mcp/v1"
        },
        "cloudbase-local": {
            "command": "npx",
            "args": [
                "-y",
                "@cloudbase/cloudbase-mcp@latest"
            ],
            "env": {
                "INTEGRATION_IDE": "Cursor"
            }
        }
    }
}
